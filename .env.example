# IskoArena environment variables
# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored — never commit real credentials.

# Public Supabase config — safe to expose to the browser.
# Found at: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret — full DB access, bypasses RLS.
# NEVER prefix with NEXT_PUBLIC_; never import from a client component.
# Found at: Supabase Dashboard → Project Settings → API → service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
