# ============================================================
# IskoArena — Environment Variables
# ============================================================
# 1. Copy this file:   cp .env.example .env.local
# 2. Fill in values from: https://supabase.com/dashboard/project/<your-project>/settings/api
# 3. NEVER commit .env.local to git
# ============================================================

# ── Supabase (Public) ────────────────────────────────────────
# Safe to expose to the browser. Found in: API Settings → URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Safe to expose to the browser. Found in: API Settings → anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Server-only) ───────────────────────────────────
# ⚠️  SECRET — NEVER prefix with NEXT_PUBLIC_, NEVER commit this value.
# Used by supabaseAdmin to bypass RLS for trusted server operations.
# Found in: API Settings → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
